# Copy to .env and fill in.

# --- Data source ---
# true  = built-in fake data (no Hubstaff needed) — good for trying out the UI
# false = real Hubstaff API (requires HUBSTAFF_PAT below)
USE_MOCK=true

# --- Hubstaff API ---
# Personal Access Token from https://developer.hubstaff.com/ (create app -> Personal
# Access Token). Despite the name it's a long-lived *refresh token*: the server exchanges
# it for a short-lived (~24h) access token and caches that in .token.json. The exchange is
# rate-limited, so we never refresh more often than needed.
HUBSTAFF_PAT=

# Organization id. Leave empty to auto-pick the first org the token can see.
HUBSTAFF_ORG_ID=

# Organization timezone — daily totals/"today" are computed in this zone.
HUBSTAFF_TZ=Europe/Moscow

# --- Behaviour ---
# Minutes since last tracked activity to still count someone as "Working" (online).
ONLINE_THRESHOLD_MIN=10

# Server-side cache TTL (seconds). The browser polls every minute; the server won't hit
# Hubstaff more often than this.
CACHE_TTL_SEC=60

# Web port.
PORT=3000
